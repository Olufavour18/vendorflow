# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (server-side only — needed for Paystack webhook, emails & admin ops)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App URL (used for Paystack callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paystack (get keys from https://dashboard.paystack.com/#/settings/developer)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Optional: Resend for transactional email (https://resend.com)
# Without this key, notifications are logged only (notification_logs table)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=VendorFlow <onboarding@resend.dev>
